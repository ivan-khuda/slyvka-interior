# Postgres. Local: docker compose (see docker-compose.yml). Production: Neon connection string.
DATABASE_URL=postgres://postgres:postgres@localhost:5435/slyvka

# Any long random string. Generate with: openssl rand -hex 32
PAYLOAD_SECRET=change-me

# Vercel Blob. Leave empty locally -> uploads are stored in ./media.
# On Vercel this is injected automatically once a Blob store is connected to the project.
BLOB_READ_WRITE_TOKEN=
